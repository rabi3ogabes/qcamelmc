{
  "version": 1,
  "sdk_version": "3.0.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://cdyycdboudurnhvqlrcb.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "qcamelmc",
      "version": "0.1.0",
      "title": "qcamelmc"
    },
    "tools": [
      {
        "name": "list_events",
        "title": "List events",
        "description": "List the ticketing events (title, date, location, capacity status), newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "include_archived": {
              "type": "boolean",
              "description": "Include archived (past season) events as well."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "How many events to return."
            }
          },
          "required": [
            "include_archived",
            "limit"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "event_sales_summary",
        "title": "Event sales summary",
        "description": "Ticket sales and gate attendance for one event: tickets sold per type, revenue, capacity left and how many holders have been scanned in.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "event_id": {
              "type": "string",
              "format": "uuid",
              "description": "Event id, as returned by list_events. Pass the current event when unsure."
            }
          },
          "required": [
            "event_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "find_booking",
        "title": "Find a booking",
        "description": "Look up one booking by its reference (for example POS-21-09-2026-UY956SR9R) and return the customer, payment status and every ticket holder with their check-in state.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "booking_reference": {
              "type": "string",
              "minLength": 4,
              "description": "The booking reference to look up."
            }
          },
          "required": [
            "booking_reference"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_customers",
        "title": "Search customers",
        "description": "Search customers by part of their name, phone number or email address, and see how many bookings each one has.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 2,
              "description": "Part of a name, phone number or email."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 25,
              "description": "How many customers to return."
            }
          },
          "required": [
            "query",
            "limit"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
