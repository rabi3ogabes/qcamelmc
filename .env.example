# Copy to .env for local development. These are PUBLIC values (they ship to every browser);
# nothing secret belongs in a VITE_* variable. Payment keys live in the admin Settings page
# and are stored in the admin-only private_settings table, never in the frontend.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR-ANON-OR-PUBLISHABLE-KEY"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-ID"
